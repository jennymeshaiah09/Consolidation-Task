{
  "name": "Product Data Consolidation (Streamlit)",
  "user": "ubuntu",
  "install": "bash .cursor/install.sh",
  "terminals": [
    {
      "name": "streamlit",
      "command": ". .venv/bin/activate && streamlit run Home.py --server.port 8501 --server.address 0.0.0.0 --server.headless true"
    }
  ],
  "ports": [
    {
      "name": "Streamlit",
      "port": 8501
    }
  ]
}
